<a href="/users" class="back-link">← Все пользователи</a>

{{#if userData}}
<div class="card mb-6">
    <h2 class="mb-6">{{userData.name}}</h2>
    <div class="kv-grid">
        <div>
            <p class="kv-label">Email</p>
            <p class="kv-value">{{userData.email}}</p>
        </div>
        <div>
            <p class="kv-label">Роль</p>
            <p class="kv-value">
                <span class="badge {{#if (eq userData.role 'ADMIN')}}badge-red{{/if}}{{#if (eq userData.role 'MANAGER')}}badge-blue{{/if}}{{#if (eq userData.role 'CLIENT')}}badge-gray{{/if}}">{{userData.role}}</span>
            </p>
        </div>
    </div>
    <div class="form-actions">
        <a href="/users/{{userData.id}}/edit" class="btn">Редактировать</a>
        <form method="POST" action="/users/{{userData.id}}/delete" onsubmit="return confirm('Удалить пользователя?')">
            <button type="submit" class="btn btn-danger">Удалить</button>
        </form>
    </div>
</div>

{{#if userData.tickets.length}}
<h3>Билеты</h3>
<div class="table-card mb-6">
    <table>
        <thead>
            <tr>
                <th>Фильм</th>
                <th>Место</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{#each userData.tickets}}
            <tr>
                <td>{{session.film.title}}</td>
                <td class="mono">{{seat}}</td>
                <td>
                    <span class="badge {{#if (eq status 'PAID')}}badge-green{{/if}}{{#if (eq status 'RESERVED')}}badge-amber{{/if}}{{#if (eq status 'CANCELLED')}}badge-red{{/if}}">{{status}}</span>
                </td>
                <td><a href="/tickets/{{id}}">Подробнее</a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{/if}}

{{#if userData.reviews.length}}
<h3>Отзывы</h3>
{{#each userData.reviews}}
<div class="review-card">
    <div>
        <a href="/films/{{film.id}}" class="kv-value">{{film.title}}</a>
        <p class="muted" style="margin: 6px 0 0;">{{comment}}</p>
    </div>
    <span class="rating">★ {{rating}}</span>
</div>
{{/each}}
{{/if}}
{{else}}
<div class="empty-state">Пользователь не найден.</div>
{{/if}}
