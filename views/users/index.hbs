<div class="page-head">
    <h2>Пользователи</h2>
    <a href="/users/add" class="btn">+ Добавить пользователя</a>
</div>

{{#if users.length}}
<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Имя</th>
                <th>Email</th>
                <th>Роль</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each users}}
            <tr>
                <td><strong>{{name}}</strong></td>
                <td class="muted">{{email}}</td>
                <td>
                    <span class="badge {{#if (eq role 'ADMIN')}}badge-red{{/if}}{{#if (eq role 'MANAGER')}}badge-blue{{/if}}{{#if (eq role 'CLIENT')}}badge-gray{{/if}}">{{role}}</span>
                </td>
                <td>
                    <div class="row-actions">
                        <a href="/users/{{id}}">Подробнее</a>
                        <a href="/users/{{id}}/edit" class="secondary">Изменить</a>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{else}}
<div class="empty-state">Пользователей нет. <a href="/users/add">Добавить первого</a></div>
{{/if}}
