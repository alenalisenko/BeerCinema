<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold">Пользователи</h2>
    <a href="/users/add" class="bg-yellow-400 hover:bg-yellow-500 text-white font-semibold py-2 px-4 rounded">+ Добавить пользователя</a>
</div>

{{#if users.length}}
<div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full">
        <thead class="bg-yellow-400 text-white">
            <tr>
                <th class="py-3 px-4 text-left">Имя</th>
                <th class="py-3 px-4 text-left">Email</th>
                <th class="py-3 px-4 text-left">Роль</th>
                <th class="py-3 px-4 text-left">Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each users}}
            <tr class="border-t hover:bg-gray-50">
                <td class="py-3 px-4 font-semibold">{{name}}</td>
                <td class="py-3 px-4 text-gray-600">{{email}}</td>
                <td class="py-3 px-4">
                    <span class="px-2 py-1 rounded text-sm
                        {{#if (eq role 'ADMIN')}}bg-red-100 text-red-700{{/if}}
                        {{#if (eq role 'MANAGER')}}bg-blue-100 text-blue-700{{/if}}
                        {{#if (eq role 'CLIENT')}}bg-gray-100 text-gray-700{{/if}}">
                        {{role}}
                    </span>
                </td>
                <td class="py-3 px-4 flex gap-2">
                    <a href="/users/{{id}}" class="text-yellow-500 hover:underline text-sm">Подробнее</a>
                    <a href="/users/{{id}}/edit" class="text-gray-500 hover:underline text-sm">Изменить</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{else}}
<p class="text-gray-500 text-center py-12">Пользователей нет. <a href="/users/add" class="text-yellow-500 underline">Добавить первого</a></p>
{{/if}}
