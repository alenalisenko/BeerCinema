<a href="/users/{{userData.id}}" class="back-link">← Назад к пользователю</a>

<div class="card form-card">
    <h2 class="mb-6">Редактировать пользователя</h2>

    {{#if userData}}
    <form method="POST" action="/users/{{userData.id}}/update">
        <div class="field">
            <label>Имя</label>
            <input type="text" name="name" value="{{userData.name}}">
        </div>
        <div class="field">
            <label>Email</label>
            <input type="email" name="email" value="{{userData.email}}">
        </div>
        <div class="field">
            <label>Новый пароль (оставьте пустым, чтобы не менять)</label>
            <input type="password" name="password">
        </div>
        <div class="field">
            <label>Роль</label>
            <select name="role">
                {{#each roles}}
                <option value="{{this}}" {{#if (eq this ../userData.role)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Сохранить</button>
            <a href="/users/{{userData.id}}" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
    {{else}}
    <p class="muted">Пользователь не найден.</p>
    {{/if}}
</div>
