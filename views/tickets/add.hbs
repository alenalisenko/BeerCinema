<div class="mb-4">
    <a href="/tickets" class="text-yellow-500 hover:underline">← Все билеты</a>
</div>

<div class="bg-white shadow rounded-lg p-6 max-w-2xl mx-auto">
    <h2 class="text-2xl font-bold mb-6">Добавить билет</h2>

    <form method="POST" action="/tickets">
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Сеанс *</label>
            <select name="sessionId" required class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="">— выберите сеанс —</option>
                {{#each sessions}}
                <option value="{{id}}">{{film.title}} · {{hall.name}} · {{startTime}}</option>
                {{/each}}
            </select>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Пользователь *</label>
            <select name="userId" required class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="">— выберите пользователя —</option>
                {{#each users}}
                <option value="{{id}}">{{name}} ({{email}})</option>
                {{/each}}
            </select>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Место * (например: A1, B12)</label>
            <input type="text" name="seat" required placeholder="A1" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
        </div>
        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">Статус</label>
            <select name="status" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="RESERVED">RESERVED — забронирован</option>
                <option value="PAID">PAID — оплачен</option>
                <option value="CANCELLED">CANCELLED — отменён</option>
            </select>
        </div>
        <div class="flex gap-3">
            <button type="submit" class="bg-yellow-400 hover:bg-yellow-500 text-white font-semibold py-2 px-6 rounded">Добавить</button>
            <a href="/tickets" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-6 rounded">Отмена</a>
        </div>
    </form>
</div>
