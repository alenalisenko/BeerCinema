<a href="/tickets" class="back-link">← Все билеты</a>

<div class="card form-card">
    <h2 class="mb-6">Добавить билет</h2>

    <form method="POST" action="/tickets">
        <div class="field">
            <label>Сеанс *</label>
            <select name="sessionId" required>
                <option value="">— выберите сеанс —</option>
                {{#each sessions}}
                <option value="{{id}}">{{film.title}} · {{hall.name}} · {{startTime}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label>Пользователь *</label>
            <select name="userId" required>
                <option value="">— выберите пользователя —</option>
                {{#each users}}
                <option value="{{id}}">{{name}} ({{email}})</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label>Место * (например: A1, B12)</label>
            <input type="text" name="seat" required placeholder="A1">
        </div>
        <div class="field">
            <label>Статус</label>
            <select name="status">
                <option value="RESERVED">RESERVED — забронирован</option>
                <option value="PAID">PAID — оплачен</option>
                <option value="CANCELLED">CANCELLED — отменён</option>
            </select>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Добавить</button>
            <a href="/tickets" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
</div>
