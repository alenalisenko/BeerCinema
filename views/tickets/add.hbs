<a href="/tickets" class="back-link">← Мои билеты</a>

<div class="card form-card">
    <h2 class="mb-6">Покупка билета</h2>

    {{#if error}}
    <div class="form-error">{{error}}</div>
    {{/if}}

    <form method="POST" action="/tickets">
        <div class="field">
            <label>Сеанс *</label>
            <select name="sessionId" id="session-select" required>
                <option value="">— выберите сеанс —</option>
                {{#each sessions}}
                <option value="{{id}}" data-capacity="{{hall.capacity}}" {{#if (eq id ../selectedSessionId)}}selected{{/if}}>{{film.title}} · {{hall.name}} · {{startTimeFormatted}} · {{price}} ₽</option>
                {{/each}}
            </select>
        </div>
        {{#if (isManager user)}}
        <div class="field">
            <label>Пользователь (для менеджера; по умолчанию — вы)</label>
            <select name="userId">
                <option value="">— я ({{user.name}}) —</option>
                {{#each users}}
                <option value="{{id}}">{{name}} ({{email}})</option>
                {{/each}}
            </select>
        </div>
        {{/if}}
        <div class="field">
            <label>Места * (можно выбрать несколько)</label>
            <input type="text" name="seat" id="seat-input" required placeholder="Выберите места на схеме" value="{{seat}}" readonly>
            <div id="hall-scheme" class="hall-scheme" hidden>
                <div class="screen-bar"></div>
                <div class="screen-label">ЭКРАН</div>
                <div id="seat-map" class="seat-map"></div>
                <div class="seat-legend">
                    <span><i class="legend-swatch"></i> свободно</span>
                    <span><i class="legend-swatch taken"></i> занято</span>
                    <span><i class="legend-swatch selected"></i> ваш выбор</span>
                </div>
            </div>
            <p class="hint" id="scheme-hint">Выберите сеанс, чтобы увидеть схему зала.</p>
        </div>
        {{#if (isManager user)}}
        <div class="field">
            <label>Статус</label>
            <select name="status">
                <option value="RESERVED">RESERVED — забронирован</option>
                <option value="PAID">PAID — оплачен</option>
                <option value="CANCELLED">CANCELLED — отменён</option>
            </select>
        </div>
        {{/if}}
        <div class="form-actions">
            <button type="submit" class="btn">Купить</button>
            <a href="/tickets" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
</div>

<script>
// Схема зала: ряды по 10 мест исходя из вместимости зала (data-capacity),
// занятые места подтягиваются из REST API выбранного сеанса.
// Кликом можно выбрать несколько мест, коды пишутся в поле через запятую.
(function () {
    const SEATS_PER_ROW = 10;
    const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

    const select = document.getElementById('session-select');
    const seatInput = document.getElementById('seat-input');
    const scheme = document.getElementById('hall-scheme');
    const map = document.getElementById('seat-map');
    const hint = document.getElementById('scheme-hint');

    let selected = new Set(
        seatInput.value.split(',').map(s => s.trim()).filter(Boolean)
    );

    function syncInput() {
        seatInput.value = Array.from(selected).join(', ');
    }

    async function renderScheme() {
        const option = select.selectedOptions[0];
        const sessionId = select.value;
        const capacity = option ? parseInt(option.dataset.capacity) : 0;

        if (!sessionId || !capacity) {
            scheme.hidden = true;
            hint.hidden = false;
            return;
        }

        let taken = [];
        try {
            const res = await fetch('/api/sessions/' + sessionId + '/tickets');
            if (res.ok) {
                const tickets = await res.json();
                taken = tickets.filter(t => t.status !== 'CANCELLED').map(t => t.seat);
            }
        } catch { /* схема остается доступной, просто без занятых мест */ }

        map.textContent = '';
        const rows = Math.ceil(capacity / SEATS_PER_ROW);
        let seatNumber = 0;

        for (let r = 0; r < rows; r++) {
            const rowEl = document.createElement('div');
            rowEl.className = 'seat-row';

            const label = document.createElement('span');
            label.className = 'seat-row-label';
            label.textContent = LETTERS[r];
            rowEl.appendChild(label);

            for (let s = 1; s <= SEATS_PER_ROW && seatNumber < capacity; s++, seatNumber++) {
                const code = LETTERS[r] + s;
                const seat = document.createElement('button');
                seat.type = 'button';
                seat.className = 'seat';
                seat.textContent = s;
                seat.title = 'Место ' + code;

                if (taken.includes(code)) {
                    seat.classList.add('taken');
                    seat.disabled = true;
                    selected.delete(code);
                } else {
                    if (selected.has(code)) seat.classList.add('selected');
                    seat.addEventListener('click', () => {
                        if (selected.has(code)) {
                            selected.delete(code);
                            seat.classList.remove('selected');
                        } else {
                            selected.add(code);
                            seat.classList.add('selected');
                        }
                        syncInput();
                    });
                }
                rowEl.appendChild(seat);
            }
            map.appendChild(rowEl);
        }

        scheme.hidden = false;
        hint.hidden = true;
        syncInput();
    }

    select.addEventListener('change', () => { selected.clear(); syncInput(); renderScheme(); });
    renderScheme();
})();
</script>
