<div class="page-head">
    <h2>Билеты</h2>
    <a href="/tickets/add" class="btn">+ Добавить билет</a>
</div>

{{#if tickets.length}}
<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Фильм</th>
                <th>Зал</th>
                <th>Место</th>
                <th>Пользователь</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each tickets}}
            <tr>
                <td>{{session.film.title}}</td>
                <td>{{session.hall.name}}</td>
                <td class="mono">{{seat}}</td>
                <td>{{user.name}}</td>
                <td>
                    <span class="badge {{#if (eq status 'PAID')}}badge-green{{/if}}{{#if (eq status 'RESERVED')}}badge-amber{{/if}}{{#if (eq status 'CANCELLED')}}badge-red{{/if}}">{{status}}</span>
                </td>
                <td>
                    <div class="row-actions">
                        <a href="/tickets/{{id}}">Подробнее</a>
                        <a href="/tickets/{{id}}/edit" class="secondary">Статус</a>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{else}}
<div class="empty-state">Билетов пока нет. <a href="/tickets/add">Добавить первый</a></div>
{{/if}}
