<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold">Билеты</h2>
    <a href="/tickets/add" class="bg-yellow-400 hover:bg-yellow-500 text-white font-semibold py-2 px-4 rounded">+ Добавить билет</a>
</div>

{{#if tickets.length}}
<div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full">
        <thead class="bg-yellow-400 text-white">
            <tr>
                <th class="py-3 px-4 text-left">Фильм</th>
                <th class="py-3 px-4 text-left">Зал</th>
                <th class="py-3 px-4 text-left">Место</th>
                <th class="py-3 px-4 text-left">Пользователь</th>
                <th class="py-3 px-4 text-left">Статус</th>
                <th class="py-3 px-4 text-left">Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each tickets}}
            <tr class="border-t hover:bg-gray-50">
                <td class="py-3 px-4">{{session.film.title}}</td>
                <td class="py-3 px-4">{{session.hall.name}}</td>
                <td class="py-3 px-4 font-mono">{{seat}}</td>
                <td class="py-3 px-4">{{user.name}}</td>
                <td class="py-3 px-4">
                    <span class="px-2 py-1 rounded text-sm
                        {{#if (eq status 'PAID')}}bg-green-100 text-green-700{{/if}}
                        {{#if (eq status 'RESERVED')}}bg-yellow-100 text-yellow-700{{/if}}
                        {{#if (eq status 'CANCELLED')}}bg-red-100 text-red-700{{/if}}">
                        {{status}}
                    </span>
                </td>
                <td class="py-3 px-4 flex gap-2">
                    <a href="/tickets/{{id}}" class="text-yellow-500 hover:underline text-sm">Подробнее</a>
                    <a href="/tickets/{{id}}/edit" class="text-gray-500 hover:underline text-sm">Статус</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{else}}
<p class="text-gray-500 text-center py-12">Билетов пока нет. <a href="/tickets/add" class="text-yellow-500 underline">Добавить первый</a></p>
{{/if}}
