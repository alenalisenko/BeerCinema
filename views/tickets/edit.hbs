<div class="mb-4">
    <a href="/tickets/{{ticket.id}}" class="text-yellow-500 hover:underline">← Назад к билету</a>
</div>

<div class="bg-white shadow rounded-lg p-6 max-w-md mx-auto">
    <h2 class="text-2xl font-bold mb-6">Изменить статус билета</h2>

    {{#if ticket}}
    <div class="mb-4 p-4 bg-gray-50 rounded">
        <p class="text-sm text-gray-500">Билет #{{ticket.id}} · Место {{ticket.seat}}</p>
        <p class="font-semibold">Текущий статус: {{ticket.status}}</p>
    </div>
    <form method="POST" action="/tickets/{{ticket.id}}/update">
        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">Новый статус</label>
            <select name="status" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                {{#each statuses}}
                <option value="{{this}}" {{#if (eq this ../ticket.status)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="flex gap-3">
            <button type="submit" class="bg-yellow-400 hover:bg-yellow-500 text-white font-semibold py-2 px-6 rounded">Сохранить</button>
            <a href="/tickets/{{ticket.id}}" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-6 rounded">Отмена</a>
        </div>
    </form>
    {{else}}
    <p class="text-gray-500">Билет не найден.</p>
    {{/if}}
</div>
