<a href="/tickets/{{ticket.id}}" class="back-link">← Назад к билету</a>

<div class="card form-card form-card-sm">
    <h2 class="mb-6">Изменить статус билета</h2>

    {{#if ticket}}
    <div class="note-box">
        <p style="margin: 0;">Билет #{{ticket.id}} · Место {{ticket.seat}}</p>
        <p style="margin: 4px 0 0;">Текущий статус: <strong>{{ticket.status}}</strong></p>
    </div>
    <form method="POST" action="/tickets/{{ticket.id}}/update">
        <div class="field">
            <label>Новый статус</label>
            <select name="status">
                {{#each statuses}}
                <option value="{{this}}" {{#if (eq this ../ticket.status)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Сохранить</button>
            <a href="/tickets/{{ticket.id}}" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
    {{else}}
    <p class="muted">Билет не найден.</p>
    {{/if}}
</div>
