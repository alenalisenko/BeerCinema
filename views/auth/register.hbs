<div class="bg-white shadow rounded-lg p-6 max-w-md mx-auto mt-8">
    <h2 class="text-2xl font-bold mb-6">Регистрация</h2>

    {{#if error}}
        <div class="bg-red-100 text-red-700 rounded px-4 py-3 mb-4">{{error}}</div>
    {{/if}}

    <form method="POST" action="/register">
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Имя *</label>
            <input type="text" name="name" required value="{{name}}" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
            <input type="email" name="email" required value="{{email}}" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
        </div>
        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">Пароль *</label>
            <input type="password" name="password" required minlength="6" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
        </div>
        <div class="flex items-center gap-3">
            <button type="submit" class="bg-yellow-400 hover:bg-yellow-500 text-white font-semibold py-2 px-6 rounded">Зарегистрироваться</button>
            <a href="/login" class="text-yellow-500 hover:underline text-sm">Уже есть аккаунт? Вход</a>
        </div>
    </form>
</div>
