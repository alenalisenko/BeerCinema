<a href="/sessions/{{session.id}}" class="back-link">← Назад к сеансу</a>

<div class="card form-card">
    <h2 class="mb-6">Редактировать сеанс</h2>

    {{#if error}}
    <div class="form-error">{{error}}</div>
    {{/if}}

    {{#if session}}
    <form method="POST" action="/sessions/{{session.id}}/update">
        <div class="field">
            <label>Фильм</label>
            <select name="filmId">
                {{#each films}}
                <option value="{{id}}" {{#if (eq id ../session.filmId)}}selected{{/if}}>{{title}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label>Зал</label>
            <select name="hallId">
                {{#each halls}}
                <option value="{{id}}" {{#if (eq id ../session.hallId)}}selected{{/if}}>{{name}} ({{capacity}} мест)</option>
                {{/each}}
            </select>
        </div>
        <div class="form-row2 field">
            <div>
                <label>Начало</label>
                <input type="datetime-local" name="startTime">
            </div>
            <div>
                <label>Конец</label>
                <input type="datetime-local" name="endTime">
            </div>
        </div>
        <div class="field">
            <label>Цена (₽)</label>
            <input type="number" name="price" value="{{session.price}}" min="0" step="0.01">
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Сохранить</button>
            <a href="/sessions/{{session.id}}" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
    {{else}}
    <p class="muted">Сеанс не найден.</p>
    {{/if}}
</div>
