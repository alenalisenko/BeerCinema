<a href="/sessions" class="back-link">← Все сеансы</a>

{{#if session}}
<div class="card mb-6">
    <h2 class="mb-6">Сеанс #{{session.id}}</h2>
    <div class="kv-grid">
        <div>
            <p class="kv-label">Фильм</p>
            <p class="kv-value"><a href="/films/{{session.film.id}}">{{session.film.title}}</a></p>
        </div>
        <div>
            <p class="kv-label">Зал</p>
            <p class="kv-value">{{session.hall.name}} ({{session.hall.capacity}} мест)</p>
        </div>
        <div>
            <p class="kv-label">Начало</p>
            <p class="kv-value">{{session.startTimeFormatted}}</p>
        </div>
        <div>
            <p class="kv-label">Конец</p>
            <p class="kv-value">{{session.endTimeFormatted}}</p>
        </div>
        <div>
            <p class="kv-label">Цена билета</p>
            <p class="kv-value rating">{{session.price}} ₽</p>
        </div>
    </div>
    <div class="form-actions">
        <a href="/tickets/add?sessionId={{session.id}}" class="btn">Купить билет</a>
    </div>
    {{#if (isManager user)}}
    <div class="form-actions">
        <a href="/sessions/{{session.id}}/edit" class="btn btn-ghost">Редактировать</a>
        <form method="POST" action="/sessions/{{session.id}}/delete" onsubmit="return confirm('Удалить сеанс?')">
            <button type="submit" class="btn btn-danger">Удалить</button>
        </form>
    </div>
    {{/if}}
</div>

{{#if session.tickets.length}}
<h3>Билеты</h3>
<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Место</th>
                <th>Пользователь</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each session.tickets}}
            <tr>
                <td class="mono">{{seat}}</td>
                <td>{{user.name}}</td>
                <td>
                    <span class="badge {{#if (eq status 'PAID')}}badge-green{{/if}}{{#if (eq status 'RESERVED')}}badge-amber{{/if}}{{#if (eq status 'CANCELLED')}}badge-red{{/if}}">{{status}}</span>
                </td>
                <td><a href="/tickets/{{id}}">Подробнее</a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{/if}}
{{else}}
<div class="empty-state">Сеанс не найден.</div>
{{/if}}
