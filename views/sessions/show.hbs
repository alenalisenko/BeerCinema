<div class="mb-4">
    <a href="/sessions" class="text-yellow-500 hover:underline">← Все сеансы</a>
</div>

{{#if session}}
<div class="bg-white shadow-lg rounded-lg p-6 mb-6">
    <h2 class="text-2xl font-bold mb-4">Сеанс #{{session.id}}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
            <p class="text-sm text-gray-500">Фильм</p>
            <p class="font-semibold"><a href="/films/{{session.film.id}}" class="text-yellow-500 hover:underline">{{session.film.title}}</a></p>
        </div>
        <div>
            <p class="text-sm text-gray-500">Зал</p>
            <p class="font-semibold">{{session.hall.name}} ({{session.hall.capacity}} мест)</p>
        </div>
        <div>
            <p class="text-sm text-gray-500">Начало</p>
            <p class="font-semibold">{{session.startTimeFormatted}}</p>
        </div>
        <div>
            <p class="text-sm text-gray-500">Конец</p>
            <p class="font-semibold">{{session.endTimeFormatted}}</p>
        </div>
        <div>
            <p class="text-sm text-gray-500">Цена билета</p>
            <p class="font-semibold text-yellow-600">{{session.price}} ₽</p>
        </div>
    </div>
    <div class="flex gap-3">
        <a href="/sessions/{{session.id}}/edit" class="bg-yellow-400 hover:bg-yellow-500 text-white py-2 px-4 rounded">Редактировать</a>
        <form method="POST" action="/sessions/{{session.id}}/delete" onsubmit="return confirm('Удалить сеанс?')">
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded">Удалить</button>
        </form>
    </div>
</div>

{{#if session.tickets.length}}
<h3 class="text-xl font-bold mb-4">Билеты</h3>
<div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full">
        <thead class="bg-yellow-400 text-white">
            <tr>
                <th class="py-3 px-4 text-left">Место</th>
                <th class="py-3 px-4 text-left">Пользователь</th>
                <th class="py-3 px-4 text-left">Статус</th>
                <th class="py-3 px-4 text-left">Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each session.tickets}}
            <tr class="border-t hover:bg-gray-50">
                <td class="py-3 px-4 font-mono">{{seat}}</td>
                <td class="py-3 px-4">{{user.name}}</td>
                <td class="py-3 px-4">{{status}}</td>
                <td class="py-3 px-4"><a href="/tickets/{{id}}" class="text-yellow-500 hover:underline text-sm">Подробнее</a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{/if}}
{{else}}
<p class="text-gray-500">Сеанс не найден.</p>
{{/if}}
