<div class="page-head">
    <h2>Сеансы</h2>
    <a href="/sessions/add" class="btn">+ Добавить сеанс</a>
</div>

<div id="sse-status" class="sse-status">● подключение к обновлениям...</div>

{{#if sessions.length}}
<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Фильм</th>
                <th>Зал</th>
                <th>Начало</th>
                <th>Конец</th>
                <th>Цена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each sessions}}
            <tr>
                <td>{{film.title}}</td>
                <td>{{hall.name}}</td>
                <td>{{startTimeFormatted}}</td>
                <td>{{endTimeFormatted}}</td>
                <td>{{price}} ₽</td>
                <td>
                    <div class="row-actions">
                        <a href="/sessions/{{id}}">Подробнее</a>
                        <a href="/sessions/{{id}}/edit" class="secondary">Изменить</a>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{else}}
<div class="empty-state">Сеансов пока нет. <a href="/sessions/add">Добавить первый</a></div>
{{/if}}

<script>
  window.addEventListener('load', function () {
  toastr.options = {
    positionClass: 'toast-bottom-right',
    timeOut: 5000,
    progressBar: true,
  };

  const statusEl = document.getElementById('sse-status');
  const eventSource = new EventSource('/sessions/events');

  eventSource.onopen = function () {
    statusEl.textContent = '● онлайн — расписание обновляется в реальном времени';
    statusEl.className = 'sse-status ok';
  };

  eventSource.onmessage = function (e) {
    const event = JSON.parse(e.data);

    if (event.action === 'created') {
      toastr.success(event.message, 'Новый сеанс');
    } else if (event.action === 'updated') {
      toastr.info(event.message, 'Сеанс изменён');
    } else if (event.action === 'deleted') {
      toastr.warning(event.message, 'Сеанс удалён');
    }

    setTimeout(() => location.reload(), 1000);
  };

  eventSource.onerror = function () {
    statusEl.textContent = '● офлайн — нет соединения';
    statusEl.className = 'sse-status err';
  };
  }); // window.addEventListener('load')
</script>
