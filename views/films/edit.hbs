<a href="/films/{{film.id}}" class="back-link">← Назад к фильму</a>

<div class="card form-card">
    <h2 class="mb-6">Редактировать фильм</h2>

    {{#if film}}
    <form method="POST" action="/films/{{film.id}}/update" enctype="multipart/form-data">
        <div class="field">
            <label>Название</label>
            <input type="text" name="title" value="{{film.title}}">
        </div>
        <div class="field">
            <label>Описание</label>
            <textarea name="description" rows="4">{{film.description}}</textarea>
        </div>
        <div class="form-row2 field">
            <div>
                <label>Длительность (мин)</label>
                <input type="number" name="duration" value="{{film.duration}}" min="1">
            </div>
            <div>
                <label>Год выпуска</label>
                <input type="number" name="releaseYear" value="{{film.releaseYear}}" min="1900" max="2100">
            </div>
        </div>
        <div class="field">
            <label>Жанр</label>
            <input type="text" name="genre" value="{{film.genre}}">
            <p class="hint">Рейтинг: {{#if film.rating}}★ {{film.rating}}{{else}}пока нет отзывов{{/if}} — считается автоматически по отзывам.</p>
        </div>
        <div class="field">
            <label>Постер</label>
            {{#if film.posterUrl}}
            <img src="{{film.posterUrl}}" alt="Текущий постер" style="height: 110px; border-radius: 10px; margin-bottom: 10px;">
            {{/if}}
            <input type="file" name="poster" accept="image/jpeg,image/png,image/webp">
            <p class="hint">или оставьте/измените URL вручную:</p>
            <input type="text" name="posterUrl" value="{{film.posterUrl}}" style="margin-top: 6px;">
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Сохранить</button>
            <a href="/films/{{film.id}}" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
    {{else}}
    <p class="muted">Фильм не найден.</p>
    {{/if}}
</div>
