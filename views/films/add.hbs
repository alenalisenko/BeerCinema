<a href="/films" class="back-link">← Все фильмы</a>

<div class="card form-card">
    <h2 class="mb-6">Добавить фильм</h2>

    <form method="POST" action="/films" enctype="multipart/form-data">
        <div class="field">
            <label>Название *</label>
            <input type="text" name="title" required>
        </div>
        <div class="field">
            <label>Описание *</label>
            <textarea name="description" required rows="4"></textarea>
        </div>
        <div class="form-row2 field">
            <div>
                <label>Длительность (мин) *</label>
                <input type="number" name="duration" required min="1">
            </div>
            <div>
                <label>Год выпуска *</label>
                <input type="number" name="releaseYear" required min="1900" max="2100">
            </div>
        </div>
        <div class="field">
            <label>Жанр *</label>
            <input type="text" name="genre" required>
            <p class="hint">Рейтинг фильма считается автоматически по отзывам зрителей.</p>
        </div>
        <div class="field">
            <label>Постер</label>
            <input type="file" name="poster" accept="image/jpeg,image/png,image/webp">
            <p class="hint">или укажите URL вручную:</p>
            <input type="text" name="posterUrl" placeholder="https://example.com/poster.jpg" style="margin-top: 6px;">
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Добавить</button>
            <a href="/films" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
</div>
