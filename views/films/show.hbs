<a href="/films" class="back-link">← Все фильмы</a>

{{#if film}}
<div class="card mb-6">
    <div class="film-hero">
        <div class="poster-wrap">
            <img src="{{film.posterUrl}}" alt="{{film.title}}">
        </div>
        <div class="film-hero-info">
            <h2>{{film.title}}</h2>
            <p class="muted">{{film.genre}} · {{film.releaseYear}} · {{film.duration}} мин.</p>
            {{#if film.rating}}<p class="rating rating-lg">★ {{film.rating}}</p>{{/if}}
            <p>{{film.description}}</p>
            {{#if (isManager user)}}
            <div class="form-actions">
                <a href="/films/{{film.id}}/edit" class="btn">Редактировать</a>
                <form method="POST" action="/films/{{film.id}}/delete" onsubmit="return confirm('Удалить фильм?')">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                </form>
            </div>
            {{/if}}
        </div>
    </div>
</div>

{{#if film.sessions.length}}
<h3>Сеансы</h3>
<div class="table-card mb-6">
    <table>
        <thead>
            <tr>
                <th>Дата и время</th>
                <th>Зал</th>
                <th>Цена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each film.sessions}}
            <tr>
                <td>{{startTime}}</td>
                <td>{{hall.name}}</td>
                <td>{{price}} ₽</td>
                <td>
                    <div class="row-actions">
                        <a href="/tickets/add?sessionId={{id}}" class="btn btn-sm">Купить билет</a>
                        <a href="/sessions/{{id}}" class="secondary">Подробнее</a>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{/if}}

<h3>Отзывы</h3>
{{#each film.reviews}}
<div class="review-card">
    <div>
        <p class="kv-value">{{user.name}}</p>
        <p class="muted" style="margin: 6px 0 0;">{{comment}}</p>
    </div>
    <span class="rating">★ {{rating}}</span>
</div>
{{else}}
<p class="muted">Отзывов пока нет — станьте первым!</p>
{{/each}}

{{#if user}}
<div class="card form-card mb-6" style="margin-top: 20px; margin-left: 0;">
    <h4>Оставить отзыв</h4>
    <form method="POST" action="/reviews">
        <input type="hidden" name="filmId" value="{{film.id}}">
        <input type="hidden" name="from" value="film">
        <div class="form-row2 field">
            <div>
                <label>Оценка (1–5)</label>
                <select name="rating" required>
                    <option value="5">★★★★★ — 5</option>
                    <option value="4">★★★★ — 4</option>
                    <option value="3">★★★ — 3</option>
                    <option value="2">★★ — 2</option>
                    <option value="1">★ — 1</option>
                </select>
            </div>
        </div>
        <div class="field">
            <label>Комментарий</label>
            <textarea name="comment" required rows="3" placeholder="Поделитесь впечатлениями о фильме"></textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Опубликовать</button>
        </div>
    </form>
</div>
{{else}}
<p class="muted" style="margin-top: 16px;"><a href="/login">Войдите</a>, чтобы оставить отзыв.</p>
{{/if}}
{{else}}
<div class="empty-state">Фильм не найден.</div>
{{/if}}
