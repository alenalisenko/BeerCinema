<a href="/films" class="back-link">← Все фильмы</a>

{{#if film}}
<div class="card mb-6">
    <div class="film-hero">
        <div class="poster-wrap">
            <img src="{{film.posterUrl}}" alt="{{film.title}}">
        </div>
        <div class="film-hero-info">
            <h2>{{film.title}}</h2>
            <p class="muted">{{film.genre}} · {{film.releaseYear}} · {{film.duration}} мин.</p>
            {{#if film.rating}}<p class="rating rating-lg">★ {{film.rating}}</p>{{/if}}
            <p>{{film.description}}</p>
            <div class="form-actions">
                <a href="/films/{{film.id}}/edit" class="btn">Редактировать</a>
                <form method="POST" action="/films/{{film.id}}/delete" onsubmit="return confirm('Удалить фильм?')">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                </form>
            </div>
        </div>
    </div>
</div>

{{#if film.sessions.length}}
<h3>Сеансы</h3>
<div class="table-card mb-6">
    <table>
        <thead>
            <tr>
                <th>Дата и время</th>
                <th>Зал</th>
                <th>Цена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each film.sessions}}
            <tr>
                <td>{{startTime}}</td>
                <td>{{hall.name}}</td>
                <td>{{price}} ₽</td>
                <td><a href="/sessions/{{id}}">Подробнее</a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{/if}}

{{#if film.reviews.length}}
<h3>Отзывы</h3>
{{#each film.reviews}}
<div class="review-card">
    <div>
        <p class="kv-value">{{user.name}}</p>
        <p class="muted" style="margin: 6px 0 0;">{{comment}}</p>
    </div>
    <span class="rating">★ {{rating}}</span>
</div>
{{/each}}
{{/if}}
{{else}}
<div class="empty-state">Фильм не найден.</div>
{{/if}}
