<div class="mb-4">
    <a href="/films" class="text-yellow-500 hover:underline">← Все фильмы</a>
</div>

{{#if film}}
<div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
    <div class="flex flex-col md:flex-row">
        <img src="{{film.posterUrl}}" alt="{{film.title}}" class="w-full md:w-64 h-80 object-cover">
        <div class="p-6 flex-1">
            <h2 class="text-3xl font-bold mb-2">{{film.title}}</h2>
            <p class="text-gray-500 mb-1">{{film.genre}} · {{film.releaseYear}} · {{film.duration}} мин.</p>
            {{#if film.rating}}<p class="text-yellow-500 font-semibold mb-3">★ {{film.rating}}</p>{{/if}}
            <p class="text-gray-700 mb-6">{{film.description}}</p>
            <div class="flex gap-3">
                <a href="/films/{{film.id}}/edit" class="bg-yellow-400 hover:bg-yellow-500 text-white py-2 px-4 rounded">Редактировать</a>
                <form method="POST" action="/films/{{film.id}}/delete" onsubmit="return confirm('Удалить фильм?')">
                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded">Удалить</button>
                </form>
            </div>
        </div>
    </div>
</div>

{{#if film.sessions.length}}
<h3 class="text-xl font-bold mb-4">Сеансы</h3>
<div class="bg-white shadow rounded-lg overflow-hidden mb-6">
    <table class="min-w-full">
        <thead class="bg-yellow-400 text-white">
            <tr>
                <th class="py-3 px-4 text-left">Дата и время</th>
                <th class="py-3 px-4 text-left">Зал</th>
                <th class="py-3 px-4 text-left">Цена</th>
                <th class="py-3 px-4 text-left">Действия</th>
            </tr>
        </thead>
        <tbody>
            {{#each film.sessions}}
            <tr class="border-t hover:bg-gray-50">
                <td class="py-3 px-4">{{startTime}}</td>
                <td class="py-3 px-4">{{hall.name}}</td>
                <td class="py-3 px-4">{{price}} ₽</td>
                <td class="py-3 px-4"><a href="/sessions/{{id}}" class="text-yellow-500 hover:underline">Подробнее</a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{/if}}

{{#if film.reviews.length}}
<h3 class="text-xl font-bold mb-4">Отзывы</h3>
<div class="space-y-4 mb-6">
    {{#each film.reviews}}
    <div class="bg-white shadow rounded-lg p-4">
        <div class="flex justify-between items-start">
            <span class="font-semibold">{{user.name}}</span>
            <span class="text-yellow-500 font-bold">★ {{rating}}</span>
        </div>
        <p class="text-gray-700 mt-2">{{comment}}</p>
    </div>
    {{/each}}
</div>
{{/if}}
{{else}}
<p class="text-gray-500">Фильм не найден.</p>
{{/if}}
