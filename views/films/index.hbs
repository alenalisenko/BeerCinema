<div class="page-head">
    <h2>Фильмы</h2>
    {{#if (isManager user)}}<a href="/films/add" class="btn">+ Добавить фильм</a>{{/if}}
</div>

{{#if films.length}}
<div class="films-grid">
    {{#each films}}
    <div class="film-card">
        <div class="poster-wrap">
            <img src="{{posterUrl}}" alt="{{title}}">
        </div>
        <div class="film-card-body">
            <h3>{{title}}</h3>
            <p class="film-meta">{{genre}} · {{releaseYear}} · {{duration}} мин.</p>
            {{#if rating}}<span class="rating">★ {{rating}}</span>{{/if}}
            <div class="film-card-actions">
                <a href="/films/{{id}}" class="btn btn-sm">Подробнее</a>
                {{#if (isManager ../user)}}<a href="/films/{{id}}/edit" class="btn btn-ghost btn-sm">Изменить</a>{{/if}}
            </div>
        </div>
    </div>
    {{/each}}
</div>
{{else}}
<div class="empty-state">Фильмов пока нет.{{#if (isManager user)}} <a href="/films/add">Добавить первый</a>{{/if}}</div>
{{/if}}
