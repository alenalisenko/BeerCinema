{{#if user}}
    <div class="user-box">
        <a href="/profile" class="user-name" title="Профиль">Вы вошли как <strong>{{user.name}}</strong></a>
        <form method="POST" action="/logout">
            <button type="submit" class="btn btn-ghost btn-sm">Выход</button>
        </form>
    </div>
{{else}}
    <a href="/login" class="btn btn-sm">Вход</a>
{{/if}}
