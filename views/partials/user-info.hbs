        <span class="text-sm">Вы вошли как <strong>{{user.name}}</strong></span>
        <button class="bg-orange-500 hover:bg-orange-600 rounded px-4 py-2">Выход</button>
    </div>
{{else}}
    <button class="bg-orange-500 rounded px-4 py-2">Вход</button>
{{/if}}