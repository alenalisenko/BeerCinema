{{#if user}}
    <div class="user-box">
        <span class="user-name">Вы вошли как <strong>{{user.name}}</strong></span>
        <form method="POST" action="/logout">
            <button type="submit" class="btn btn-ghost btn-sm">Выход</button>
        </form>
    </div>
{{else}}
    <a href="/login" class="btn btn-sm">Вход</a>
{{/if}}
