<h2 class="section-h">Конструктор расписания</h2>

<form id="schedule-form" class="card form-card">
    <div class="field">
        <label for="start-time">Время начала:</label>
        <input type="time" id="start-time" name="start-time">
    </div>

    <div class="field">
        <label for="end-time">Время окончания:</label>
        <input type="time" id="end-time" name="end-time">
    </div>

    <div class="field">
        <label for="max-movies">Количество фильмов:</label>
        <input type="number" id="max-movies" name="max-movies" min="1">
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">Создать расписание</button>
    </div>
</form>

<div id="schedule-output" class="mt-6"></div>
