<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head}}
</head>
<body class="bg-yellow-50">
    {{> header}}

    <main class="container mx-auto p-4 pt-24">
        {{{body}}}
    </main>

    {{> footer}}

    {{#if serverElapsed}}
    <div class="fixed bottom-3 right-3 bg-black/70 text-white text-xs px-3 py-1.5 rounded-full shadow">
        Server: {{serverElapsed}}ms | Client: <span id="timing-client">…</span>
    </div>
    <script>
        document.getElementById('timing-client').textContent = Math.round(performance.now()) + 'ms';
    </script>
    {{/if}}

    {{> scripts}}
</body>
</html>
