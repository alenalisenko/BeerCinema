<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head}}
</head>
<body>
    {{> header}}

    <main class="wrap">
        {{{body}}}
    </main>

    {{> footer}}

    {{#if serverElapsed}}
    <div class="timing-pill">
        Server: {{serverElapsed}}ms | Client: <span id="timing-client">…</span>
    </div>
    <script>
        document.getElementById('timing-client').textContent = Math.round(performance.now()) + 'ms';
    </script>
    {{/if}}

    {{> scripts}}
</body>
</html>
