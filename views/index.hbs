<section class="hero">
    <h1>Добро пожаловать в <span class="gold">BeerCinema</span></h1>
    <p>Удобная система бронирования билетов на лучшие фильмы</p>
    <a href="#schedule" class="btn">Посмотреть расписание</a>
</section>

<section class="mt-6">
    <h3 class="section-h">Ближайшие показы</h3>

    <div class="swiper-container">
        <div class="swiper-wrapper">
            {{#each films}}
            <div class="swiper-slide">
                <div class="film-card">
                    <div class="poster-wrap">
                        <img src="{{posterUrl}}" alt="{{title}}">
                    </div>
                    <div class="film-card-body">
                        <h3>{{title}}</h3>
                        {{#if time}}<p class="film-meta">Ближайший сеанс: {{time}}</p>{{/if}}
                        <div class="film-card-actions">
                            <a href="/tickets/add" class="btn btn-sm">Купить билет</a>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-pagination"></div>
    </div>
</section>

<section id="schedule">
    <h3 class="section-h">Расписание сеансов</h3>
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Фильм</th>
                    <th>Время</th>
                    <th>Зал</th>
                </tr>
            </thead>
            <tbody>
                {{#each schedule}}
                <tr>
                    <td>{{film}}</td>
                    <td>{{time}}</td>
                    <td>{{hall}}</td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="3" class="text-center muted">Сеансов пока нет — загляните позже</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    <div class="center-row">
        <a href="/sessions" class="btn btn-ghost">Полное расписание</a>
    </div>
</section>
