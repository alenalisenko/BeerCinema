<a href="/reviews" class="back-link">← Все отзывы</a>

{{#if review}}
<div class="card form-card">
    <div class="page-head" style="margin-bottom: 16px;">
        <h2 style="margin: 0;">Отзыв #{{review.id}}</h2>
        <span class="rating rating-lg">★ {{review.rating}}</span>
    </div>
    <div class="mb-6">
        <div class="split-row">
            <span class="kv-label">Фильм</span>
            <a href="/films/{{review.film.id}}" class="kv-value">{{review.film.title}}</a>
        </div>
        <div class="split-row">
            <span class="kv-label">Автор</span>
            <a href="/users/{{review.user.id}}" class="kv-value">{{review.user.name}}</a>
        </div>
    </div>
    <p class="kv-label">Комментарий</p>
    <p>{{review.comment}}</p>
    {{#if canEdit}}
    <div class="form-actions">
        <a href="/reviews/{{review.id}}/edit" class="btn">Редактировать</a>
        <form method="POST" action="/reviews/{{review.id}}/delete" onsubmit="return confirm('Удалить отзыв?')">
            <button type="submit" class="btn btn-danger">Удалить</button>
        </form>
    </div>
    {{/if}}
</div>
{{else}}
<div class="empty-state">Отзыв не найден.</div>
{{/if}}
