<a href="/reviews/{{review.id}}" class="back-link">← Назад к отзыву</a>

<div class="card form-card">
    <h2 class="mb-6">Редактировать отзыв</h2>

    {{#if review}}
    <div class="note-box">
        <p style="margin: 0;">Фильм: <strong>{{review.film.title}}</strong></p>
        <p style="margin: 4px 0 0;">Автор: <strong>{{review.user.name}}</strong></p>
    </div>
    <form method="POST" action="/reviews/{{review.id}}/update">
        <div class="field">
            <label>Оценка (1–5)</label>
            <input type="number" name="rating" value="{{review.rating}}" min="1" max="5">
        </div>
        <div class="field">
            <label>Комментарий</label>
            <textarea name="comment" rows="4">{{review.comment}}</textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Сохранить</button>
            <a href="/reviews/{{review.id}}" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
    {{else}}
    <p class="muted">Отзыв не найден.</p>
    {{/if}}
</div>
