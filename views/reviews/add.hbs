<a href="/reviews" class="back-link">← Все отзывы</a>

<div class="card form-card">
    <h2 class="mb-6">Добавить отзыв</h2>

    <form method="POST" action="/reviews">
        <div class="field">
            <label>Фильм *</label>
            <select name="filmId" required>
                <option value="">— выберите фильм —</option>
                {{#each films}}
                <option value="{{id}}">{{title}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label>Пользователь *</label>
            <select name="userId" required>
                <option value="">— выберите пользователя —</option>
                {{#each users}}
                <option value="{{id}}">{{name}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label>Оценка * (1–5)</label>
            <input type="number" name="rating" required min="1" max="5">
        </div>
        <div class="field">
            <label>Комментарий *</label>
            <textarea name="comment" required rows="4"></textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Добавить</button>
            <a href="/reviews" class="btn btn-ghost">Отмена</a>
        </div>
    </form>
</div>
