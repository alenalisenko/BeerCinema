<div class="mb-4">
    <a href="/reviews" class="text-yellow-500 hover:underline">← Все отзывы</a>
</div>

<div class="bg-white shadow rounded-lg p-6 max-w-2xl mx-auto">
    <h2 class="text-2xl font-bold mb-6">Добавить отзыв</h2>

    <form method="POST" action="/reviews">
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Фильм *</label>
            <select name="filmId" required class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="">— выберите фильм —</option>
                {{#each films}}
                <option value="{{id}}">{{title}}</option>
                {{/each}}
            </select>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Пользователь *</label>
            <select name="userId" required class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="">— выберите пользователя —</option>
                {{#each users}}
                <option value="{{id}}">{{name}}</option>
                {{/each}}
            </select>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Оценка * (1–5)</label>
            <input type="number" name="rating" required min="1" max="5" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400">
        </div>
        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-1">Комментарий *</label>
            <textarea name="comment" required rows="4" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400"></textarea>
        </div>
        <div class="flex gap-3">
            <button type="submit" class="bg-yellow-400 hover:bg-yellow-500 text-white font-semibold py-2 px-6 rounded">Добавить</button>
            <a href="/reviews" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-6 rounded">Отмена</a>
        </div>
    </form>
</div>
