<div class="page-head">
    <h2>Отзывы</h2>
    {{#if user}}<a href="/reviews/add" class="btn">+ Добавить отзыв</a>{{/if}}
</div>

{{#if reviews.length}}
{{#each reviews}}
<div class="review-card">
    <div style="flex: 1;">
        <p style="margin: 0 0 4px;">
            <a href="/films/{{film.id}}" class="kv-value">{{film.title}}</a>
            <span class="muted"> · {{user.name}}</span>
        </p>
        <p class="muted" style="margin: 0; font-size: 0.92rem;">{{comment}}</p>
    </div>
    <div style="display: flex; align-items: center; gap: 16px;">
        <span class="rating">★ {{rating}}</span>
        <a href="/reviews/{{id}}" style="font-size: 0.88rem;">Подробнее</a>
    </div>
</div>
{{/each}}
{{else}}
<div class="empty-state">Отзывов пока нет.{{#if user}} <a href="/reviews/add">Добавить первый</a>{{/if}}</div>
{{/if}}
